# Vercel KV（Vercelダッシュボードから自動設定されます）
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Slack App設定（後で入力）
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx
SLACK_SIGNING_SECRET=xxxxxxxxxxxxxxxxxx

# 勤怠対象のSlackユーザーID（Slackで @自分の名前 を右クリック→プロフィール→「…」→メンバーIDをコピー）
TARGET_SLACK_USER_ID=U00000000
